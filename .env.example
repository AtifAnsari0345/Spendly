# Spendly environment variables — NAMES ONLY. Fill real values in .env.local
# (gitignored). Never commit credentials, and never prefix secrets with NEXT_PUBLIC_.

# MongoDB Atlas connection string (server-only).
# Template: mongodb+srv://<username>:<password>@<cluster-host>/<database>
MONGODB_URI=

# Better Auth session-signing secret (server-only).
# Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Base URL of this app, used by Better Auth for callbacks/cookies (server-only).
# Must match the origin the app is actually served from, otherwise Better Auth
# rejects sign-in/sign-out POSTs with 403 INVALID_ORIGIN.
# Local development: http://localhost:3000  •  Production: your real public URL.
BETTER_AUTH_URL=

# Extra origins allowed to call the auth endpoints, comma-separated (server-only,
# optional). Use it when the app is reachable from more than one origin, e.g. a
# preview deployment or a LAN address. Localhost origins on any port are already
# trusted automatically outside production.
# Example: https://spendly.example.com,https://preview.spendly.example.com
BETTER_AUTH_TRUSTED_ORIGINS=
